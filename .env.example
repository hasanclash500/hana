# Public Convex deployment URL, no credentials.
NEXT_PUBLIC_CONVEX_URL=https://energetic-butterfly-143.eu-west-1.convex.cloud
# Optional HTTP Actions endpoint; currently unused.
NEXT_PUBLIC_CONVEX_HTTP_ACTIONS_URL=https://energetic-butterfly-143.eu-west-1.convex.site
# Set to the actual Vercel deployment origin for metadata and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search crawlers should not index development / preview sites.
HANA_ALLOW_INDEXING=false
